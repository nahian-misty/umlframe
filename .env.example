# Copy to .env (which is gitignored) and fill in; never commit real secrets.
DATABASE_URL=sqlite:///./umlframe.db

# Optional: LLM method implementation via OpenRouter (UML -> Code, "Implement methods with AI").
# Leave the key empty to disable the feature.
OPENROUTER_API_KEY=
# Comma-separated model ids, tried in order when one is rate-limited or unavailable,
# e.g. a free model id from https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=
